{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Khonsu JSON output v1.0",
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "position"
            },
            "data": {
              "$ref": "#/$defs/position"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "report"
            },
            "data": {
              "$ref": "#/$defs/report"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "passes"
            },
            "data": {
              "$ref": "#/$defs/passes"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "tonight"
            },
            "data": {
              "$ref": "#/$defs/tonight"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "track"
            },
            "data": {
              "$ref": "#/$defs/track"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "look"
            },
            "data": {
              "$ref": "#/$defs/look"
            }
          },
          "required": [
            "kind",
            "data"
          ]
        }
      ]
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "enum": [
            "position",
            "report",
            "passes",
            "tonight",
            "track",
            "look"
          ]
        },
        "data": {},
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "data",
        "provenance",
        "warnings"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "celestrak",
            "file",
            "stdin",
            "unknown"
          ]
        },
        "source_format": {
          "enum": [
            "tle",
            "gp-json"
          ]
        },
        "element_epoch": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "fetched_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_status": {
          "enum": [
            "fetched",
            "fresh",
            "stale",
            "none",
            "unknown"
          ]
        }
      },
      "required": [
        "source",
        "source_format",
        "element_epoch",
        "fetched_at",
        "cache_status"
      ]
    },
    "position": {
      "type": "object",
      "properties": {
        "catalog_id": {
          "type": "string",
          "pattern": "^0*[1-9][0-9]*$"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "exclusiveMaximum": 180
        },
        "altitude_km": {
          "type": "number"
        },
        "speed_km_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "catalog_id",
        "evaluated_at",
        "latitude_deg",
        "longitude_deg",
        "altitude_km",
        "speed_km_s"
      ]
    },
    "report": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "catalog_id": {
          "type": "string",
          "pattern": "^0*[1-9][0-9]*$"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "orbit": {
          "type": "object",
          "properties": {
            "inclination_deg": {
              "type": "number"
            },
            "eccentricity": {
              "type": "number"
            },
            "mean_motion_rev_day": {
              "type": "number"
            },
            "period_minutes": {
              "type": "number"
            },
            "apogee_km": {
              "type": "number"
            },
            "perigee_km": {
              "type": "number"
            },
            "orbit_class_estimate": {
              "type": "string"
            },
            "explanation": {
              "$ref": "#/$defs/orbit_explanation"
            }
          },
          "required": [
            "inclination_deg",
            "eccentricity",
            "mean_motion_rev_day",
            "period_minutes",
            "apogee_km",
            "perigee_km",
            "orbit_class_estimate"
          ]
        },
        "tle": {
          "type": "string"
        },
        "map_url": {
          "type": "string"
        },
        "source_format": {
          "enum": [
            "tle",
            "gp-json"
          ]
        },
        "element_data": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "catalog_id",
        "position",
        "orbit",
        "tle",
        "map_url"
      ]
    },
    "passes": {
      "type": "object",
      "properties": {
        "catalog_id": {
          "type": "string",
          "pattern": "^0*[1-9][0-9]*$"
        },
        "observer": {
          "type": "object",
          "properties": {
            "latitude_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude_deg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "altitude_km": {
              "type": "number"
            }
          },
          "required": [
            "latitude_deg",
            "longitude_deg",
            "altitude_km"
          ]
        },
        "window_start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "window_end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "minimum_elevation_deg": {
          "const": 0
        },
        "sample_step_seconds": {
          "type": "number",
          "minimum": 1
        },
        "passes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "end": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "rise_at": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "set_at": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maximum_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "maximum_elevation_deg": {
                "type": "number",
                "minimum": 0,
                "maximum": 90
              },
              "start_clipped": {
                "type": "boolean"
              },
              "end_clipped": {
                "type": "boolean"
              },
              "start_azimuth_deg": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "maximum_azimuth_deg": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "end_azimuth_deg": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              }
            },
            "required": [
              "start",
              "end",
              "rise_at",
              "set_at",
              "maximum_at",
              "maximum_elevation_deg",
              "start_clipped",
              "end_clipped"
            ]
          }
        }
      },
      "required": [
        "catalog_id",
        "observer",
        "window_start",
        "window_end",
        "minimum_elevation_deg",
        "sample_step_seconds",
        "passes"
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "error"
      ]
    },
    "look_point": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "azimuth_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "elevation_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        }
      },
      "required": [
        "at",
        "azimuth_deg",
        "elevation_deg"
      ]
    },
    "tonight": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "catalog_id": {
          "type": "string",
          "pattern": "^0*[1-9][0-9]*$"
        },
        "observer": {
          "type": "object",
          "properties": {
            "latitude_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude_deg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "altitude_km": {
              "type": "number"
            }
          },
          "required": [
            "latitude_deg",
            "longitude_deg",
            "altitude_km"
          ]
        },
        "dark_start": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dark_end": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dark_end_clipped": {
          "type": "boolean"
        },
        "minimum_elevation_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 90
        },
        "maximum_sun_elevation_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 0
        },
        "passes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "$ref": "#/$defs/look_point"
              },
              "peak": {
                "$ref": "#/$defs/look_point"
              },
              "end": {
                "$ref": "#/$defs/look_point"
              },
              "ends_in_shadow": {
                "type": "boolean"
              }
            },
            "required": [
              "start",
              "peak",
              "end",
              "ends_in_shadow"
            ]
          }
        }
      },
      "required": [
        "name",
        "catalog_id",
        "observer",
        "dark_start",
        "dark_end",
        "dark_end_clipped",
        "minimum_elevation_deg",
        "maximum_sun_elevation_deg",
        "passes"
      ]
    },
    "track": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "catalog_id": {
          "type": "string",
          "pattern": "^0*[1-9][0-9]*$"
        },
        "frame": {
          "const": "TEME"
        },
        "step_seconds": {
          "type": "number",
          "minimum": 1
        },
        "period_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sun_km": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ]
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "latitude_deg": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude_deg": {
                "type": "number",
                "minimum": -180,
                "exclusiveMaximum": 180
              },
              "altitude_km": {
                "type": "number"
              },
              "speed_km_s": {
                "type": "number",
                "minimum": 0
              },
              "sunlit": {
                "type": "boolean"
              },
              "azimuth_deg": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "elevation_deg": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            },
            "required": [
              "time",
              "x",
              "y",
              "z",
              "latitude_deg",
              "longitude_deg",
              "altitude_km",
              "speed_km_s",
              "sunlit"
            ]
          }
        }
      },
      "required": [
        "name",
        "catalog_id",
        "frame",
        "step_seconds",
        "period_minutes",
        "sun_km",
        "samples"
      ]
    },
    "look": {
      "type": "object",
      "properties": {
        "catalog_id": {
          "type": "string",
          "pattern": "^0*[1-9][0-9]*$"
        },
        "observer": {
          "type": "object",
          "properties": {
            "latitude_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude_deg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "altitude_km": {
              "type": "number"
            }
          },
          "required": [
            "latitude_deg",
            "longitude_deg",
            "altitude_km"
          ]
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "azimuth_deg": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "elevation_deg": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            },
            "required": [
              "at",
              "azimuth_deg",
              "elevation_deg"
            ]
          }
        }
      },
      "required": [
        "catalog_id",
        "observer",
        "points"
      ]
    },
    "orbit_explanation": {
      "type": "object",
      "description": "Additive in 1.0. Plain-language reasons for the orbit, derived from mean elements. See docs/orbit-estimates.md.",
      "properties": {
        "regime": {
          "type": "string"
        },
        "regime_name": {
          "type": "string"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "statements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "basis": {
                "enum": [
                  "derived",
                  "heuristic"
                ]
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    }
                  },
                  "required": [
                    "label",
                    "title",
                    "url"
                  ]
                }
              }
            },
            "required": [
              "id",
              "text",
              "basis",
              "sources"
            ]
          }
        },
        "nodal_precession_deg_day": {
          "type": "number",
          "description": "Secular drift of the ascending node from SGP4, degrees per day"
        },
        "descending_node_local_time_hours": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 24
        },
        "repeat_ground_track": {
          "type": "object",
          "properties": {
            "days": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "nodal_days": {
              "type": "integer",
              "minimum": 1
            },
            "revolutions": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "days",
            "nodal_days",
            "revolutions"
          ]
        }
      },
      "required": [
        "regime",
        "regime_name",
        "patterns",
        "statements",
        "nodal_precession_deg_day"
      ]
    }
  }
}
