[build-system]
requires = ["setuptools>=61"]
build-backend = "setuptools.build_meta"

[project]
name = "{{.Command}}"
version = "0.1.0"
description = "Summarize TLEGO position JSON"
requires-python = ">=3.10"

[project.scripts]
{{.Command}} = "{{.Module}}:main"

[tool.setuptools]
py-modules = ["{{.Module}}"]
