import copy
import unittest

from {{.Module}} import summarize

FIXTURE = {"schema_version": "1.0", "kind": "position", "data": {
    "catalog_id": "25544", "evaluated_at": "2026-10-24T05:01:11Z",
    "latitude_deg": 12.5, "longitude_deg": -45.5, "altitude_km": 420, "speed_km_s": 7.66},
    "future_field": "ignored"}


class SummaryTests(unittest.TestCase):
    def test_summary(self):
        self.assertIn("Satellite 25544", summarize(FIXTURE))

    def test_rejects_wrong_major_or_kind(self):
        for key, value in (("schema_version", "2.0"), ("schema_version", 1.0), ("kind", "passes")):
            document = copy.deepcopy(FIXTURE)
            document[key] = value
            with self.assertRaises(ValueError):
                summarize(document)

    def test_rejects_missing_or_nonfinite_coordinates(self):
        for value in (None, float("nan"), True):
            document = copy.deepcopy(FIXTURE)
            document["data"]["latitude_deg"] = value
            with self.assertRaises(ValueError):
                summarize(document)


if __name__ == "__main__":
    unittest.main()
